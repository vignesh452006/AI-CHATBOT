{
  "name": "Order",
  "type": "object",
  "properties": {
    "customer_name": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "items": {
      "type": "string"
    },
    "total": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "Placed",
        "Confirmed",
        "Preparing",
        "Out for Delivery",
        "Delivered",
        "Cancelled"
      ],
      "default": "Placed"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "Cash on Delivery",
        "Online Payment"
      ],
      "default": "Cash on Delivery"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "customer_name",
    "phone",
    "address",
    "items",
    "total"
  ]
}